+rcl_interfaces::msg::SetParametersResult SimulationNode::OnSetParameters(
+    const std::vector<rclcpp::Parameter> &parameters) {
+  rcl_interfaces::msg::SetParametersResult result;
+  result.successful = true;
+
+  double front = front_grip_scale_;
+  double rear = rear_grip_scale_;
+  for (const auto &parameter : parameters) {
+    if (parameter.get_name() == "dynamics.front_grip_scale") {
+      front = parameter.as_double();
+    } else if (parameter.get_name() == "dynamics.rear_grip_scale") {
+      rear = parameter.as_double();
+    }
+  }
+
+  constexpr double kMinScale = 0.35;
+  constexpr double kMaxScale = 1.30;
+  if (!std::isfinite(front) || !std::isfinite(rear) || front < kMinScale ||
+      front > kMaxScale || rear < kMinScale || rear > kMaxScale) {
+    result.successful = false;
+    result.reason = "grip scales must be finite and within [0.35, 1.30]";
+    return result;
+  }
+
+  sim_->GetCore().SetTyreScales(front, rear);
+  front_grip_scale_ = front;
+  rear_grip_scale_ = rear;
+  result.reason = "grip scales applied";
+  return result;
+}
